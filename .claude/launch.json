{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "dev-auto-port",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3200,
      "autoPort": true
    },
    {
      "name": "prod-start",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start"],
      "port": 3400,
      "autoPort": true
    }
  ]
}
